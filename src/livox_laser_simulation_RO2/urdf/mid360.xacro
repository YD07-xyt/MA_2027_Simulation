<?xml version="1.0" encoding="UTF-8"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:property name="M_PI" value="3.141592653589793"/>
  <!-- 参数对齐 Livox Mid-360 实物（参考 livox_gz_sim）
       盲区 0.1 m，量程 40 m (10% 反射率)，垂直 FOV [-7.4 deg, +52.4 deg] 完整覆盖
       mid360.csv [-7.212 deg, +52.164 deg]。
       Gazebo Harmonic gpu_lidar 以 OGRE2 GPU 深度图 50 Hz（5 子帧/帧）渲染 0.4 deg 球面测距栅格
       （901x151，像素量化标准差 0.4/sqrt(12)=0.115 deg < Mid-360 标称 0.15 deg），
       再由 mid360_gz_bridge 按 mid360.csv 非重复扫描表重采样、注入高斯噪声并输出
       10 Hz / 20000 点 / 多子帧时间戳的 CustomMsg 与 LivoxPointXyzrtlt PointCloud2。 -->
  <xacro:property name="laser_min_range" value="0.1"/>
  <xacro:property name="laser_max_range" value="40.0"/>
  <xacro:property name="range_resolution" value="0.001"/>
  <xacro:property name="gpu_update_rate" value="50.0"/>
  <xacro:property name="gpu_horizontal_samples" value="901"/>
  <xacro:property name="gpu_vertical_samples" value="151"/>

  <xacro:macro name="mid360" params="name:='livox_frame' parent:='base_link' topic:='/livox/lidar' gz_topic:='/livox/lidar/gz_scan' *origin">

    <link name="${name}">
      <visual>
        <origin xyz="0.025 -0.0265 -0.025" rpy="${pi/2} 0 ${pi}"/>
        <geometry>
          <mesh filename="model://mid360.stl" scale="0.0008 0.0008 0.0008"/>
        </geometry>
      </visual>
    </link>

    <joint name="${name}_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${name}"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <gazebo reference="${name}">
      <sensor type="gpu_lidar" name="${name}">
        <pose>0 0 0 0 0 0</pose>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <update_rate>${gpu_update_rate}</update_rate>
        <topic>${gz_topic}</topic>
        <gz_frame_id>${name}</gz_frame_id>
        <lidar>
          <scan>
            <horizontal>
              <samples>${gpu_horizontal_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-M_PI}</min_angle>
              <max_angle>${M_PI}</max_angle>
            </horizontal>
            <vertical>
              <samples>${gpu_vertical_samples}</samples>
              <resolution>1</resolution>
              <min_angle>${-7.4 / 180.0 * M_PI}</min_angle>
              <max_angle>${52.4 / 180.0 * M_PI}</max_angle>
            </vertical>
          </scan>
          <range>
            <min>${laser_min_range}</min>
            <max>${laser_max_range}</max>
            <resolution>${range_resolution}</resolution>
          </range>
        </lidar>
      </sensor>
    </gazebo>

  </xacro:macro>

</robot>
