<?xml version="1.0"?>

<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:property name="length_wheel" value="0.05" />
  <xacro:property name="radius_wheel" value="0.06" />
  <xacro:property name="PI" value="3.1415926"/>
  <xacro:macro name="default_inertial" params="mass">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="0.01" ixy="0.0" ixz="0.0"
                    iyy="0.01" iyz="0.0" izz="0.01" />
    </inertial>
  </xacro:macro>

  <!-- base_link to livox_frame -->
  <!-- <xacro:arg name="xyz" default="-0.038 0.0 0.433" />
  <xacro:arg name="rpy" default="3.14 0 0" /> -->
  <xacro:arg name="xyz" default="0.0 0.0 0.15" />
  <xacro:arg name="rpy" default="0 0 0" />
  <xacro:arg name="use_livox" default="true" />

  <link name="mesh"/>

  <link name="base_link">
    <visual>
      <geometry>
        <box size="0.2 .3 .1"/>
      </geometry>
      <origin rpy="0 0 ${PI/2}" xyz="0 0 0.05"/>
      <material name="orange">
        <color rgba="0.95 0.45 0.1 1"/>
      </material>
    </visual>
    <collision>
      <geometry>
        <box size="0.2 .3 0.1"/>
      </geometry>
      <origin rpy="0 0 ${PI/2}" xyz="0 0 0.05"/>
    </collision>
    <xacro:default_inertial mass="8.2"/>
  </link>

  <joint name="mesh_joint" type="fixed">
     <parent link="mesh"/>
     <child link="base_link"/>
  </joint>

  <link name="wheel_1">
    <visual>
      <geometry>
        <cylinder length="${length_wheel}" radius="${radius_wheel}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="red">
        <color rgba="0.85 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <geometry>
        <sphere radius="${radius_wheel}"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.5"/>
  </link>

  <link name="wheel_2">
    <visual>
      <geometry>
        <cylinder length="${length_wheel}" radius="${radius_wheel}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="black">
        <color rgba="0.15 0.15 0.15 1"/>
      </material>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.025"/>
      <geometry>
        <sphere radius="${radius_wheel}"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.5"/>
  </link>

  <link name="wheel_3">
    <visual>
      <geometry>
        <cylinder length="${length_wheel}" radius="${radius_wheel}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <material name="red"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <geometry>
        <sphere radius="${radius_wheel}"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.5"/>
  </link>

  <link name="wheel_4">
    <visual>
      <geometry>
        <cylinder length="${length_wheel}" radius="${radius_wheel}"/>
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0" />
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0.025"/>
      <geometry>
        <sphere radius="${radius_wheel}"/>
      </geometry>
    </collision>
    <xacro:default_inertial mass="0.5"/>
  </link>

  <!-- 轮子关节保留轻微阻尼与摩擦，由全向底盘动力学插件施加水平驱动力与偏航力矩，
       竖直方向与地形俯仰/滚转完全交由重力与轮地接触约束求解。 -->
  <joint name="base_to_wheel1" type="continuous">
    <parent link="base_link"/>
    <child link="wheel_1"/>
    <origin rpy="${-PI/2} 0 0" xyz="0.1 0.13 0"/>
    <axis xyz="0 0 1" />
    <dynamics damping="0.01" friction="0.05"/>
  </joint>

  <joint name="base_to_wheel2" type="continuous">
    <axis xyz="0 0 1" />
    <anchor xyz="0 0 0" />
    <limit effort="100" velocity="100" />
    <parent link="base_link"/>
    <child link="wheel_2"/>
    <origin rpy="${-PI/2} 0 0" xyz="-0.1 0.13 0"/>
    <dynamics damping="0.01" friction="0.05"/>
  </joint>

  <joint name="base_to_wheel3" type="continuous">
    <parent link="base_link"/>
    <axis xyz="0 0 1" />
    <child link="wheel_3"/>
    <origin rpy="${-PI/2} 0 0" xyz="0.1 -0.13 0"/>
    <dynamics damping="0.01" friction="0.05"/>
  </joint>

  <joint name="base_to_wheel4" type="continuous">
    <parent link="base_link"/>
    <axis xyz="0 0 1" />
    <child link="wheel_4"/>
    <origin rpy="${-PI/2} 0 0" xyz="-0.1 -0.13 0"/>
    <dynamics damping="0.01" friction="0.05"/>
  </joint>

  <!-- IMU joint 说明（注意注释里不要出现英文冒号加空格）
       Mid-360 内置 IMU，挂在雷达坐标系下，随雷达 xyz/rpy 参数一起移动。
       偏移量由本仓库 Super-LIO 配置反推：
         lio.extrinsic.lidar_imu = [-0.011, -0.02329, 0.04412, I]   (LiDAR 在 IMU 系下的平移)
       => IMU 在 LiDAR 系下 = (0.011, 0.02329, -0.04412)，旋转为单位阵。
       这样仿真里 IMU 与 LiDAR 的相对几何，和 Super-LIO 内部假设的外参完全一致。 -->
  <joint name="imu_joint" type="fixed">
    <origin xyz="0.011 0.02329 -0.04412" rpy="0 0 0"/>
    <parent link="livox_frame"/>
    <child link="imu_link"/>
  </joint>

  <!-- IMU：在雷达外壳内部，不需要单独的外观和碰撞体 -->
  <link name="imu_link">
    <inertial>
      <mass value="1e-2" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <!-- 轮地与底盘低滑动摩擦：允许底盘在全向力控下自由横移/旋转，避免坡顶/边沿剐蹭锁死 -->
  <gazebo reference="base_link">
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
  </gazebo>
  <gazebo reference="wheel_1">
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
  </gazebo>
  <gazebo reference="wheel_2">
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
  </gazebo>
  <gazebo reference="wheel_3">
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
  </gazebo>
  <gazebo reference="wheel_4">
    <mu1>0.02</mu1>
    <mu2>0.02</mu2>
  </gazebo>

  <!-- Gazebo Harmonic 全向底盘控制器与关节状态发布 -->
  <gazebo>
    <plugin filename="pb_rm_omni_chassis_system" name="pb_rm_simulation::OmniChassisSystem">
      <topic>/cmd_vel</topic>
      <link_name>base_link</link_name>
      <kp_linear>22.0</kp_linear>
      <ki_linear>25.0</ki_linear>
      <kp_angular>30.0</kp_angular>
      <ki_angular>40.0</ki_angular>
      <static_hold_kp>120.0</static_hold_kp>
      <static_hold_ki>80.0</static_hold_ki>
      <static_yaw_kp>80.0</static_yaw_kp>
      <max_linear_vel>5.0</max_linear_vel>
      <max_angular_vel>10.0</max_angular_vel>
      <max_linear_accel>8.0</max_linear_accel>
      <max_angular_accel>25.0</max_angular_accel>
      <max_force>150.0</max_force>
      <max_torque>30.0</max_torque>
      <cmd_timeout>0.0</cmd_timeout>
    </plugin>

    <plugin filename="gz-sim-joint-state-publisher-system"
            name="gz::sim::systems::JointStatePublisher">
      <topic>/joint_states</topic>
      <joint_name>base_to_wheel1</joint_name>
      <joint_name>base_to_wheel2</joint_name>
      <joint_name>base_to_wheel3</joint_name>
      <joint_name>base_to_wheel4</joint_name>
      <update_rate>50</update_rate>
    </plugin>

    <!-- 3D 真值里程计（仅发布 /sim/ground_truth/odom，不桥接 /tf，避免与 Super-LIO TF 冲突） -->
    <plugin filename="gz-sim-odometry-publisher-system"
            name="gz::sim::systems::OdometryPublisher">
      <dimensions>3</dimensions>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_link</robot_base_frame>
      <odom_topic>/sim/ground_truth/odom</odom_topic>
      <odom_publish_frequency>50</odom_publish_frequency>
      <gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </gazebo>

  <!-- mid360_imu：仿 Livox Mid-360 内置 IMU (ICM40609)
       - 200 Hz，由 Gazebo Harmonic gz-sim-imu-system 原生输出并经 ros_gz_bridge 桥接到 /livox/imu。
       - frame_id 为 imu_link，与 URDF 外参和 Super-LIO lio.extrinsic.lidar_imu 对齐。 -->
  <gazebo reference="imu_link">
    <sensor name="mid360_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>200</update_rate>
      <topic>/livox/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
      <imu>
        <angular_velocity>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.002</stddev></noise></z>
        </angular_velocity>
        <linear_acceleration>
          <x><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></x>
          <y><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></y>
          <z><noise type="gaussian"><mean>0.0</mean><stddev>0.02</stddev></noise></z>
        </linear_acceleration>
      </imu>
    </sensor>
  </gazebo>

  <!-- Livox-Mid360（阶段 2 启用 GPU 雷达与非重复扫描桥接） -->
  <xacro:if value="$(arg use_livox)">
    <xacro:include filename="$(find ros2_livox_simulation)/urdf/mid360.xacro" />
    <xacro:mid360 name="livox_frame" parent="base_link" topic="/livox/lidar">
      <origin xyz="$(arg xyz)" rpy="$(arg rpy)" />
    </xacro:mid360>
  </xacro:if>
  <xacro:unless value="$(arg use_livox)">
    <link name="livox_frame">
      <visual>
        <origin xyz="0.025 -0.0265 -0.025" rpy="${PI/2} 0 ${PI}"/>
        <geometry>
          <mesh filename="model://mid360.stl" scale="0.0008 0.0008 0.0008"/>
        </geometry>
      </visual>
    </link>
    <joint name="livox_frame_joint" type="fixed">
      <parent link="base_link"/>
      <child link="livox_frame"/>
      <origin xyz="$(arg xyz)" rpy="$(arg rpy)"/>
    </joint>
  </xacro:unless>

</robot>
