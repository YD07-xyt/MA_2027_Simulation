<?xml version="1.0"?>
<sdf version="1.9">
  <world name="default">
    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type="adiabatic"/>

    <scene>
      <ambient>0.55 0.55 0.55 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
    </scene>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>0</latitude_deg>
      <longitude_deg>0</longitude_deg>
      <elevation>0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <light name="user_directional_light_0" type="directional">
      <pose>7.32 3.82 13 0 0 0</pose>
      <diffuse>0.7 0.7 0.7 1</diffuse>
      <specular>0.15 0.15 0.15 1</specular>
      <direction>0.1 0.1 -0.9</direction>
      <attenuation>
        <range>50</range>
        <constant>0.5</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
          <max_contacts>10</max_contacts>
        </collision>
        <visual name="visual">
          <cast_shadows>false</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <model name="RMUL_2024">
      <static>true</static>
      <pose>1.0 -0.5 2.65 0 0 0</pose>
      <link name="link_3">
        <pose>0 0 -3e-06 0 0 0</pose>
        <visual name="visual">
          <pose>0 0 0 -1.5705 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://RMUL2024_world/meshes/RMUL_2024.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
            <double_sided>true</double_sided>
          </material>
        </visual>
        <collision name="collision">
          <max_contacts>10</max_contacts>
          <pose>0 0 0 -1.5705 0 0</pose>
          <geometry>
            <mesh>
              <uri>model://RMUL2024_world/meshes/RMUL_2024.stl</uri>
              <scale>0.001 0.001 0.001</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1</mu>
                <mu2>1</mu2>
              </ode>
            </friction>
            <contact>
              <ode/>
            </contact>
            <bounce/>
          </surface>
        </collision>
      </link>
    </model>

    <!-- Dynamic obstacles driven by Gazebo Harmonic pb_rm_dynamic_obstacle_system -->
    <model name="dynamic_obstacle_1">
      <static>false</static>
      <pose>5.0 4.5 1.3 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <laser_retro>120</laser_retro>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.4 0.7 1.0</ambient>
            <diffuse>1.0 0.4 0.7 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
      <plugin filename="pb_rm_dynamic_obstacle_system" name="pb_rm_simulation::DynamicObstacleSystem">
        <mode>ellipse</mode>
        <relative>true</relative>
        <radius_x>1.0</radius_x>
        <radius_y>2.0</radius_y>
        <period>60.0</period>
      </plugin>
    </model>

    <model name="dynamic_obstacle_2">
      <static>false</static>
      <pose>6.5 5.5 1.3 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <laser_retro>120</laser_retro>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.4 0.9 0.4 1.0</ambient>
            <diffuse>0.4 0.9 0.4 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
      <plugin filename="pb_rm_dynamic_obstacle_system" name="pb_rm_simulation::DynamicObstacleSystem">
        <mode>waypoints</mode>
        <relative>true</relative>
        <loop>true</loop>
        <waypoint>0.0 -2.0 0.0 0.0</waypoint>
        <waypoint>35.0 2.0 0.0 0.0</waypoint>
        <waypoint>70.0 -2.0 0.0 0.0</waypoint>
      </plugin>
    </model>

    <model name="dynamic_obstacle_3">
      <static>false</static>
      <pose>6.0 2.0 1.3 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <laser_retro>120</laser_retro>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.3 0.6 1.0 1.0</ambient>
            <diffuse>0.3 0.6 1.0 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
      <plugin filename="pb_rm_dynamic_obstacle_system" name="pb_rm_simulation::DynamicObstacleSystem">
        <mode>waypoints</mode>
        <relative>true</relative>
        <loop>true</loop>
        <waypoint>0.0 0.0 0.0 0.0</waypoint>
        <waypoint>10.0 -1.0 0.2 0.0</waypoint>
        <waypoint>40.0 -2.0 1.0 0.0</waypoint>
        <waypoint>55.0 -3.5 0.0 0.0</waypoint>
        <waypoint>85.0 -2.5 1.5 0.0</waypoint>
        <waypoint>110.0 0.0 0.0 0.0</waypoint>
        <waypoint>130.0 -1.0 2.0 0.0</waypoint>
        <waypoint>145.0 -2.0 1.0 0.0</waypoint>
        <waypoint>165.0 0.0 0.0 0.0</waypoint>
      </plugin>
    </model>

    <model name="dynamic_obstacle_4">
      <static>false</static>
      <pose>9.5 2.0 1.3 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <laser_retro>120</laser_retro>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>1.0 0.7 0.2 1.0</ambient>
            <diffuse>1.0 0.7 0.2 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
      <plugin filename="pb_rm_dynamic_obstacle_system" name="pb_rm_simulation::DynamicObstacleSystem">
        <mode>waypoints</mode>
        <relative>true</relative>
        <loop>true</loop>
        <waypoint>0.0 0.0 0.0 0.0</waypoint>
        <waypoint>10.0 0.0 -3.2 0.0</waypoint>
        <waypoint>30.0 2.0 -2.7 0.0</waypoint>
        <waypoint>40.0 0.0 0.0 0.0</waypoint>
        <waypoint>60.0 0.0 -3.2 0.0</waypoint>
        <waypoint>80.0 2.0 -2.7 0.0</waypoint>
        <waypoint>110.0 0.0 0.0 0.0</waypoint>
        <waypoint>130.0 0.0 -3.2 0.0</waypoint>
        <waypoint>150.0 2.0 -2.7 0.0</waypoint>
        <waypoint>170.0 0.0 0.0 0.0</waypoint>
      </plugin>
    </model>

    <model name="dynamic_obstacle_5">
      <static>false</static>
      <pose>3.0 4.0 1.3 0 0 0</pose>
      <link name="link">
        <gravity>false</gravity>
        <kinematic>true</kinematic>
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <laser_retro>120</laser_retro>
          <geometry>
            <cylinder>
              <radius>0.3</radius>
              <length>0.5</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.3 0.3 1.0</ambient>
            <diffuse>0.9 0.3 0.3 1.0</diffuse>
            <specular>0.2 0.2 0.2 1.0</specular>
          </material>
        </visual>
      </link>
      <plugin filename="pb_rm_dynamic_obstacle_system" name="pb_rm_simulation::DynamicObstacleSystem">
        <mode>waypoints</mode>
        <relative>true</relative>
        <loop>true</loop>
        <waypoint>0.0 0.0 0.0 0.0</waypoint>
        <waypoint>10.0 0.0 -3.2 0.0</waypoint>
        <waypoint>30.0 2.0 -2.7 0.0</waypoint>
        <waypoint>40.0 0.0 0.0 0.0</waypoint>
        <waypoint>60.0 0.0 -3.2 0.0</waypoint>
        <waypoint>80.0 2.0 -2.7 0.0</waypoint>
        <waypoint>110.0 0.0 0.0 0.0</waypoint>
        <waypoint>130.0 0.0 -3.2 0.0</waypoint>
        <waypoint>150.0 2.0 -2.7 0.0</waypoint>
        <waypoint>170.0 0.0 0.0 0.0</waypoint>
      </plugin>
    </model>
  </world>
</sdf>
